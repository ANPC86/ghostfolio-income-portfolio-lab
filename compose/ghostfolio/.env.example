# Copy to .env and replace every <random>. Generate values with:
#   openssl rand -hex 32        (64 hex characters; use for the salt and the JWT key)
#   openssl rand -base64 24     (passwords)
# The salt derives every user's security token — set it once, before first start,
# and never change it afterwards (doing so invalidates all logins).

COMPOSE_PROJECT_NAME=ghostfolio

# CACHE
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<random>

# POSTGRES
POSTGRES_DB=ghostfolio-db
POSTGRES_USER=user
POSTGRES_PASSWORD=<random>

# VARIOUS
ACCESS_TOKEN_SALT=<random 64 hex>
JWT_SECRET_KEY=<random 64 hex>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?connect_timeout=300

# Optional — only if you put Ghostfolio behind a reverse proxy and use OIDC or the built-in MCP,
# whose allowed host/origin is derived from this value.
# ROOT_URL=https://ghostfolio.example.lan

# Optional — the built-in, read-only, values-redacted MCP endpoint at /mcp (see README §2).
# ENABLE_FEATURE_MCP=true
