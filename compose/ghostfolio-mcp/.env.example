# Copy to .env. Keep this file out of version control — it holds a Ghostfolio security token.

# Where the MCP server finds Ghostfolio. Must include the scheme; a bare host name makes
# every tool call fail with "Request URL is missing an 'http://' or 'https://' protocol".
GHOSTFOLIO_URL=http://ghostfolio:3333
GHOSTFOLIO_VERIFY_SSL=true
GHOSTFOLIO_TIMEOUT=30

# The security token of the ONE Ghostfolio user this server represents.
# For a demo or read-only setup use a dedicated non-admin user, never the admin token.
GHOSTFOLIO_TOKEN=<security token>

# true  = the ~36 tools can read everything the user sees, but no create/update/delete.
# false = writes allowed (activities, accounts, watchlist, market data). Start with true.
READ_ONLY_MODE=true

# What MCP clients must present as "Authorization: Bearer ...". Generate with openssl rand -hex 32.
MCP_HTTP_BEARER_TOKEN=<random>

# Host headers the HTTP transport accepts. List every way clients will address it:
# the NAS IP and published port, and any reverse-proxy hostname.
FASTMCP_HTTP_ALLOWED_HOSTS=["<nas-ip>:8438","127.0.0.1:8438","localhost:8438"]

# Optional: hide whole tool groups from the client, e.g. GHOSTFOLIO_DISABLED_TAGS=admin
GHOSTFOLIO_DISABLED_TAGS=
